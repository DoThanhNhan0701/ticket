# DEV: copy this file to .env.development.
# Run: npm run dev | Build: npm run build:dev | Preview: npm run preview:dev
VITE_API_BASE_URL=http://192.168.30.69:8001
DEV_ALLOWED_HOSTS=192.168.30.69,localhost,ticket-new.aiminds.io.vn
VITE_VIETNAM_ADDRESS_API_URL=https://provinces.open-api.vn/api/v2
TEST_BASE_URL=http://127.0.0.1:5173

# TEST: copy this file to .env.test and replace the values below (also used by Docker).
# Run: npm run dev:test | Build: npm run build:test | Preview: npm run preview:test
# VITE_API_BASE_URL=https://ticket-api.aiminds.io.vn
# DEV_ALLOWED_HOSTS=ticket-new.aiminds.io.vn,localhost,127.0.0.1
# TEST_BASE_URL=https://ticket-new.aiminds.io.vn

# PROD: copy this file to .env.production and replace the values below.
# Run: npm run dev:prod | Build: npm run build:prod | Preview: npm run preview:prod
# VITE_API_BASE_URL=https://ticket.rainscales.com.vn
# DEV_ALLOWED_HOSTS=ticket.rainscales.com.vn,localhost,127.0.0.1
# TEST_BASE_URL=https://ticket.rainscales.com.vn
# Build before preview; every mode writes to dist. npm run build defaults to PROD.
